{
  "name": "acilis-ekrani",
  "productName": "Açılış Ekranı",
  "version": "0.4.1",
  "description": "Bilgisayar açılınca gelen takvim, ayet, hadis ve İslam sanatı ekranı",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "paketle": "electron-builder --win",
    "yayinla": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.sema.acilisekrani",
    "productName": "Acilis Ekrani",
    "files": [
      "src/**/*",
      "veri/**/*",
      "gorseller/**/*",
      "ses/**/*",
      "package.json",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/simge.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mehmetbezginsiha-source",
        "repo": "acilis-ekrani",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@huggingface/transformers": "^4.3.2",
    "electron-updater": "^6.3.9",
    "msedge-tts": "^2.1.1"
  }
}